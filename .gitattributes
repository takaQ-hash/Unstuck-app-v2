# See https://git-scm.com/docs/gitattributes for more about git attribute files.

* text=auto eol=lf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.pdf binary

# Mark the database schema as having been generated.
backend/db/schema.rb linguist-generated

# Mark any vendored files as having been vendored.
backend/vendor/** linguist-vendored

frontend/package-lock.json linguist-generated
frontend/yarn.lock linguist-generated
frontend/pnpm-lock.yaml linguist-generated
**/.terraform.lock.hcl linguist-generated

# Rails credentialsの差分表示ドライバ
backend/config/credentials/*.yml.enc diff=rails_credentials
backend/config/credentials.yml.enc diff=rails_credentials
